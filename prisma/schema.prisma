generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum WorkRole {
  product
  live
  gallery_ops
  systems
}

model Work {
  id           String            @id @default(cuid())
  slug         String            @unique
  role         WorkRole
  href         String
  repoUrl      String?
  sortOrder    Int               @default(0)
  published    Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  translations WorkTranslation[]

  @@index([role])
  @@index([published, sortOrder])
}

model WorkTranslation {
  id         String  @id @default(cuid())
  workId     String
  locale     String
  name       String
  descriptor String?
  work       Work    @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([workId, locale])
  @@index([locale])
}

model Locale {
  code      String  @id
  label     String
  enabled   Boolean @default(true)
  sortOrder Int     @default(0)
}

model Message {
  key      String
  locale   String
  value    String
  /// False until a human has read this row in its own language. Drafts seeded
  /// for a locale we cannot yet vouch for never count as reviewed.
  reviewed Boolean @default(false)

  @@unique([key, locale])
  @@index([locale])
}

model ApiKey {
  id        String    @id @default(cuid())
  label     String
  keyHash   String    @unique
  scopes    String[]
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  usage     AiUsage[]
}

model AiUsage {
  id           String   @id @default(cuid())
  apiKeyId     String?
  route        String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  latencyMs    Int
  outcome      String
  costUsd      Decimal? @db.Decimal(12, 6)
  createdAt    DateTime @default(now())
  apiKey       ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([apiKeyId, createdAt])
  @@index([createdAt])
}

model RateLimit {
  bucket      String
  windowStart DateTime
  count       Int      @default(0)

  @@id([bucket, windowStart])
}
