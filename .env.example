# AI door configuration.
#
# The door itself needs no provider. It answers 501 `provider_unconfigured`
# until a later ticket supplies an adapter (see app/api/v1/ai/_lib/provider.ts).

# Kill switch for POST /api/v1/ai/[...route].
# When set to one of 1 / true / yes / on (case-insensitive) the door returns
# 503 `ai_door_disabled` before touching the database, without a redeploy.
# Unset, empty, 0, false, or any other value leaves the door open.
AI_DOOR_DISABLED=

# Reserved: the provider selector a later ticket reads in resolveProvider().
# Unset today; no upstream provider is configured and none is assumed.
AI_PROVIDER=

# Postgres connection string (Prisma driver adapter). Also used by modules/content
# and modules/ratelimit. Required for key verification and rate limiting.
DATABASE_URL=
